#include <dt-bindings/clock/spacemit,k1-syscon.h>
#include "binman.dtsi"

/ {
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x00000000 0x00000000 0x80000000>;
	};
};

&syscon_mpmu {
	clocks = <&osc_32k>, <&vctcxo_1m>, <&vctcxo_3m>, <&vctcxo_24m>,
		 <&pll CLK_PLL1_D4>;
	clock-names = "osc", "vctcxo_1m", "vctcxo_3m", "vctcxo_24m",
		      "pll1_d4";
};

&syscon_apbc {
	clocks = <&osc_32k>, <&vctcxo_1m>, <&vctcxo_3m>, <&vctcxo_24m>,
		 <&pll CLK_PLL1_D4>,
		 <&syscon_mpmu CLK_PLL1_31P5>,
		 <&syscon_apmu CLK_PMUA_ACLK>;
	clock-names = "osc", "vctcxo_1m", "vctcxo_3m", "vctcxo_24m",
		      "pll1_d4", "pll1_d78_31p5", "pmua_aclk";
};

&binman {
	u-boot-spl-ddr {
		type = "section";
		filename = "u-boot-spl-ddr.bin";
		pad-byte = <0xff>;

		u-boot-spl {
		};

		ddr-fw {
			type = "blob";
			filename = "ddr_fw.bin";
			align = <64>;
		};

		u-boot-any {
			type = "section";
			size = <0>;
			offset = <0>;
		};
	};
};

&{/soc} {
	bootph-all;
};

&vctcxo_1m {
	bootph-pre-ram;
};

&vctcxo_24m {
	bootph-pre-ram;
};

&vctcxo_3m {
	bootph-pre-ram;
};

&osc_32k {
	bootph-pre-ram;
};

&syscon_mpmu {
	bootph-pre-ram;
};

&pll {
	bootph-pre-ram;
};

&syscon_apmu {
	bootph-pre-ram;
};

&syscon_apbc {
	bootph-pre-ram;
};

&uart0 {
	bootph-pre-ram;
};

&i2c2 {
	bootph-pre-ram;

	eeprom@50 {
		bootph-pre-ram;
	};
};

&i2c8 {
	bootph-pre-ram;

	pmic@41 {
		bootph-pre-ram;

		regulators {
			bootph-pre-ram;

			buck1 {
				regulator-name = "vdd_core";
				bootph-pre-ram;
			};

			buck3 {
				regulator-name = "vdd_1v8";
				bootph-pre-ram;
			};

			aldo1 {
				regulator-name = "vdd_1v8_mmc";
				bootph-pre-ram;
			};
		};
	};
};

&uart0 {
	/*
	 * TODO(sjg): experiment - the k1 clk driver reports 24MHz for the
	 * UART clock but output garbles when the divisor is reprogrammed;
	 * force the true 14.7456MHz reference and bypass the clock driver
	 */
	/delete-property/ resets;
	/delete-property/ clocks;
	/delete-property/ clock-names;
	clock-frequency = <14745600>;
};
