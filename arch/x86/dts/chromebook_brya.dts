// SPDX-License-Identifier: GPL-2.0+
/*
 * Copyright 2026 Simon Glass <sjg@chromium.org>
 *
 * Brya-class Chromebook (Alder Lake), running U-Boot natively
 */

/dts-v1/;

#include <dt-bindings/clock/intel-clock.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gpio/intel-adl-gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/include/ "skeleton.dtsi"
/include/ "rtc.dtsi"
/include/ "reset.dtsi"

#include "tsc_timer.dtsi"

/ {
	model = "Google Chromebook brya";
	compatible = "google,brya", "intel,alderlake";

	aliases {
		/*
		 * Number the I2C bus as the hardware does, so the ACPI name
		 * inferred for the generated SSDT (I2C1) matches the device
		 * declared in the DSDT
		 */
		i2c1 = &i2c_1;
		serial0 = &serial;
	};

	chosen {
		stdout-path = &serial;
	};

	clk: clock {
		compatible = "intel,apl-clk";
		#clock-cells = <1>;
	};

	/*
	 * The PMC's ACPI I/O space (IOMAP_ACPI_BASE, 0x100 bytes). The
	 * GPE0 status registers sit at 0x60 within it on this PCH,
	 * unlike the usual 0x20
	 */
	acpi_gpe: general-purpose-events {
		reg = <0x1800 0x100>;
		compatible = "intel,acpi-gpe";
		gpe0-sts = <0x60>;
		interrupt-controller;
		#interrupt-cells = <2>;
	};

	config {
		silent-console = <0>;
	};

	/*
	 * The console. This uses the UART's MMIO directly, rather than a PCI
	 * node, since probing a PCI device means enumerating the bus, which
	 * cannot be done before silicon init. The BAR is set up by the early
	 * console code in TPL
	 */
	serial: serial@fe03e000 {
		bootph-all;
		compatible = "intel,apl-ns16550";
		reg = <0xfe03e000 0x100>;
		early-regs = <0xfe03e000 0x100>;
		reg-shift = <2>;
		clock-frequency = <1843200>;
		current-speed = <115200>;
	};

	board {
		bootph-pre-ram;
		compatible = "google,brya-board";

		/*
		 * The DRAM-ID straps, which select the SPD data to use. They
		 * are read as a binary value, with the first GPIO as bit 0
		 */
		memory-id-gpios = <&gpio_e GPP_E11 GPIO_ACTIVE_HIGH>,
				  <&gpio_e GPP_E2 GPIO_ACTIVE_HIGH>,
				  <&gpio_e GPP_E1 GPIO_ACTIVE_HIGH>,
				  <&gpio_e GPP_E12 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * The CPUs provide the MADT local-APIC entries and the CPU count
	 * for the ACPI tables. This processor (i3-1215U) has two P-cores
	 * with two threads each and four E-cores; the APIC IDs follow the
	 * Alder Lake hybrid layout, with a stride of 8 between P-cores and
	 * 2 between E-cores
	 */
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "intel,alderlake-cpu";
			reg = <0>;
			intel,apic-id = <0>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "intel,alderlake-cpu";
			reg = <1>;
			intel,apic-id = <1>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "intel,alderlake-cpu";
			reg = <2>;
			intel,apic-id = <8>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "intel,alderlake-cpu";
			reg = <3>;
			intel,apic-id = <9>;
		};

		cpu@4 {
			device_type = "cpu";
			compatible = "intel,alderlake-cpu";
			reg = <4>;
			intel,apic-id = <0x10>;
		};

		cpu@5 {
			device_type = "cpu";
			compatible = "intel,alderlake-cpu";
			reg = <5>;
			intel,apic-id = <0x12>;
		};

		cpu@6 {
			device_type = "cpu";
			compatible = "intel,alderlake-cpu";
			reg = <6>;
			intel,apic-id = <0x14>;
		};

		cpu@7 {
			device_type = "cpu";
			compatible = "intel,alderlake-cpu";
			reg = <7>;
			intel,apic-id = <0x16>;
		};
	};

	pci {
		compatible = "pci-x86";
		#address-cells = <3>;
		#size-cells = <2>;
		bootph-all;
		/*
		 * The ECAM region is at 0xc0000000, so PCI memory goes above
		 * it, below the 4GB MMIO which the SoC uses
		 */
		ranges = <0x02000000 0x0 0xd0000000 0xd0000000 0 0x20000000
			  0x42000000 0x0 0x90000000 0x90000000 0 0x30000000
			  0x01000000 0x0 0x1000 0x1000 0 0xefff>;
		u-boot,skip-auto-config-until-reloc;

		/*
		 * The PCIe root ports are not usable until silicon init has
		 * run, and scanning them before that hangs the platform, so
		 * only the devices in this devicetree are used until then
		 */
		u-boot,skip-enumeration-until-reloc;

		/*
		 * The console UART, used via the MMIO node above; disable
		 * it here so that PCI enumeration leaves its BAR alone
		 */
		serial-pci@1e,0 {
			reg = <0x0000f000 0 0 0 0>;
			status = "disabled";
		};

		northbridge: host-bridge@0,0 {
			reg = <0x00000000 0 0 0 0>;
			bootph-pre-ram;
			bootph-some-ram;
			compatible = "intel,alderlake-hostbridge";
			/* Its 'BARs' are fixed registers, not real BARs */
			pci,no-autoconfig;
		};

		i2c_1: i2c@15,1 {
			compatible = "intel,apl-i2c", "snps,designware-i2c-pci";
			reg = <0x0200a910 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <400000>;
			i2c,speeds = <100000 400000>;
			clocks = <&clk CLK_I2C>;
			i2c-scl-rising-time-ns = <650>;
			i2c-scl-falling-time-ns = <400>;

			/*
			 * The Google Security Chip (Cr50), providing the TPM.
			 * Its command-complete signal on GPP_A13 is a short
			 * pulse, which polling the pad level would miss, so
			 * the pad routes to SCI and the driver watches the
			 * latched GPE status: GPP_A is on GPE0 DW0, so
			 * GPP_A13 is GPE number 13
			 */
			tpm: tpm@50 {
				reg = <0x50>;
				compatible = "google,cr50";
				u-boot,i2c-offset-len = <0>;
				interrupts-extended = <&acpi_gpe 13
					IRQ_TYPE_EDGE_FALLING>;
				acpi,hid = "GOOG0005";
				acpi,ddn = "I2C TPM";
				acpi,name = "TPMI";
			};
		};

		p2sb: p2sb@1f,1 {
			reg = <0x0000f900 0 0 0 0>;
			bootph-all;
			compatible = "intel,p2sb";
			early-regs = <0xfd000000 0x1000000>;
			pci,no-autoconfig;

			/*
			 * The interrupt controller. GPE routing is not set up
			 * yet, so the route table is empty
			 */
			itss {
				bootph-all;
				compatible = "intel,itss";
				intel,p2sb-port-id = <0xc4>;
				intel,pmc-routes = <0 0>;
			};

			/* GPIO community 0 holds GPP_B, T, A */
			pinctrl_com0 {
				compatible = "intel,alderlake-pinctrl";
				intel,p2sb-port-id = <PID_GPIOCOM0>;
				gpio_a: gpio-com0 {
					compatible = "intel,gpio";
					gpio-controller;
					#gpio-cells = <2>;
				};
			};

			/* GPIO community 4 holds GPP_C, F, E */
			pinctrl_com4 {
				compatible = "intel,alderlake-pinctrl";
				bootph-all;
				intel,p2sb-port-id = <PID_GPIOCOM4>;
				gpio_e: gpio-com4 {
					compatible = "intel,gpio";
					bootph-all;
					gpio-controller;
					#gpio-cells = <2>;
				};
			};
		};

		spi: fast-spi@1f,5 {
			reg = <0x0000fd00 0 0 0 0>;
			bootph-pre-ram;
			bootph-some-ram;
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "intel,fast-spi";
			early-regs = <0xfe010000 0x1000>;
			intel,hardware-seq = <1>;
			/*
			 * Sizing this BAR breaks the flash memory map, which
			 * U-Boot is running from
			 */
			pci,no-autoconfig;

			fwstore_spi: spi-flash@0 {
				#address-cells = <1>;
				#size-cells = <1>;
				bootph-pre-ram;
				bootph-some-ram;
				reg = <0>;
				m25p,fast-read;
				compatible = "winbond,w25q256jw",
					 "jedec,spi-nor";

				rw-mrc-cache {
					label = "rw-mrc-cache";
					reg = <0x01000000 0x20000>;
					bootph-pre-ram;
					bootph-some-ram;
				};
			};
		};
	};
};
