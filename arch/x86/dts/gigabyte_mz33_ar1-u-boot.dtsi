// SPDX-License-Identifier: GPL-2.0+
/*
 * Copyright 2026 Simon Glass <sjg@chromium.org>
 *
 * The PSP decompresses the BIOS image into DRAM and starts the CPU at the
 * reset vector in its last 16 bytes, so that image is laid out at its DRAM
 * address rather than at the top of 4GB. The PSP only starts an image of up
 * to 1MB.
 *
 * Without SPL, the BIOS image is the whole of U-Boot, with the microcode
 * patches, at the address given by CONFIG_TEXT_BASE
 *
 * With SPL, the BIOS image holds just SPL, at the address given by
 * CONFIG_SPL_TEXT_BASE, and U-Boot proper and the microcode patches stay in
 * the flash, which is mapped in memory, where SPL copies U-Boot from. They
 * are in the same image as the BIOS image so that binman can tell SPL where
 * U-Boot is, but only the BIOS image's own file goes into the PSP directory:
 * that is u-boot-mz33.bin
 */

#include <config.h>

/*
 * Only meaningful for this board's own build; other x86 builds compile
 * every devicetree in the directory
 */
#ifdef CONFIG_TARGET_MZ33_AR1
/ {
	binman {
		pad-byte = <0xff>;
		sort-by-offset;
#ifdef CONFIG_SPL
		filename = "u-boot-mz33-flash.bin";
		skip-at-start = <CONFIG_TURIN_IMAGE_ADDR>;

		bios {
			type = "section";
			filename = "u-boot-mz33.bin";
			offset = <CONFIG_TURIN_IMAGE_ADDR>;
			size = <(CONFIG_RESET_VEC_LOC + 0x10 -
				 CONFIG_SPL_TEXT_BASE)>;
			pad-byte = <0xff>;

			/*
			 * Offsets are from CONFIG_SPL_TEXT_BASE, where the PSP
			 * puts the image. U-Boot's position is its address in
			 * the flash
			 */
			u-boot-spl {
				offset = <0>;
				symbols-base = <0>;
			};
			x86-start16-spl {
				offset = <(CONFIG_SYS_X86_START16 -
					   CONFIG_SPL_TEXT_BASE)>;
			};
			/* padded, so that the file fills the section */
			x86-reset16-spl {
				offset = <(CONFIG_RESET_VEC_LOC -
					   CONFIG_SPL_TEXT_BASE)>;
				size = <0x10>;
			};
		};

		u-boot {
		};
#else
		filename = "u-boot-mz33.bin";
		skip-at-start = <CONFIG_TEXT_BASE>;
		size = <CONFIG_ROM_SIZE>;

		u-boot {
			offset = <CONFIG_TEXT_BASE>;
		};
#endif

		/*
		 * The microcode patches for each processor revision, from AMD
		 * as the Dasharo image carries them. Without SPL the PSP copies
		 * them into DRAM with the rest of the image; with SPL they are
		 * read from the flash
		 */
		amd-ucode-b000 {
			type = "blob-ext";
			filename = "cpu_microcode_b000.bin";
			align = <16>;
		};
		amd-ucode-b010 {
			type = "blob-ext";
			filename = "cpu_microcode_b010.bin";
			align = <16>;
		};
		amd-ucode-b020 {
			type = "blob-ext";
			filename = "cpu_microcode_b020.bin";
			align = <16>;
		};
		amd-ucode-b021 {
			type = "blob-ext";
			filename = "cpu_microcode_b021.bin";
			align = <16>;
		};
		amd-ucode-b100 {
			type = "blob-ext";
			filename = "cpu_microcode_b100.bin";
			align = <16>;
		};
		amd-ucode-b110 {
			type = "blob-ext";
			filename = "cpu_microcode_b110.bin";
			align = <16>;
		};
#ifndef CONFIG_SPL
		x86-start16 {
			offset = <CONFIG_SYS_X86_START16>;
		};
		x86-reset16 {
			offset = <CONFIG_RESET_VEC_LOC>;
		};
#endif
	};
};
#endif
