/*
 * Copyright 2026 Simon Glass <sjg@chromium.org>
 *
 * The PSP decompresses this whole image into DRAM at CONFIG_TEXT_BASE and
 * starts the CPU at the reset vector in its last 16 bytes, so the image is
 * laid out at its DRAM address rather than at the top of 4GB
 */

#include <config.h>

/*
 * Only meaningful for this board's own build; other x86 builds compile
 * every devicetree in the directory
 */
#ifdef CONFIG_TARGET_MZ33_AR1
/ {
	binman {
		filename = "u-boot-mz33.bin";
		pad-byte = <0xff>;
		sort-by-offset;
		skip-at-start = <CONFIG_TEXT_BASE>;
		size = <CONFIG_ROM_SIZE>;

		u-boot {
			offset = <CONFIG_TEXT_BASE>;
		};

		/*
		 * The microcode patches for each processor revision, from AMD
		 * as the Dasharo image carries them; the PSP copies them into
		 * DRAM with the rest of the image
		 */
		amd-ucode-b000 {
			type = "blob-ext";
			filename = "cpu_microcode_b000.bin";
			align = <16>;
		};
		amd-ucode-b010 {
			type = "blob-ext";
			filename = "cpu_microcode_b010.bin";
			align = <16>;
		};
		amd-ucode-b020 {
			type = "blob-ext";
			filename = "cpu_microcode_b020.bin";
			align = <16>;
		};
		amd-ucode-b021 {
			type = "blob-ext";
			filename = "cpu_microcode_b021.bin";
			align = <16>;
		};
		amd-ucode-b100 {
			type = "blob-ext";
			filename = "cpu_microcode_b100.bin";
			align = <16>;
		};
		amd-ucode-b110 {
			type = "blob-ext";
			filename = "cpu_microcode_b110.bin";
			align = <16>;
		};
		x86-start16 {
			offset = <CONFIG_SYS_X86_START16>;
		};
		x86-reset16 {
			offset = <CONFIG_RESET_VEC_LOC>;
		};
	};
};
#endif
