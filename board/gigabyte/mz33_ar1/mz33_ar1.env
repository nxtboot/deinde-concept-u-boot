#include <env/x86.env>

/* There is no keyboard or display for U-Boot, only the BMC's serial port */
stdin=serial
stdout=serial
stderr=serial

/*
 * Boot the OS directly from a Boot Loader Specification entry, before
 * trying anything else; the EFI boot manager is left out since EFI booting
 * does not work yet on this board
 */
bootmeths=bls extlinux script efi
