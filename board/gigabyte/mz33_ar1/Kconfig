if TARGET_MZ33_AR1

config SYS_BOARD
	default "mz33_ar1"

config SYS_VENDOR
	default "gigabyte"

config SYS_SOC
	default "turin"

config BOARD_SPECIFIC_OPTIONS # dummy
	def_bool y
	select ARCH_AMD_TURIN
	select BOARD_ROMSIZE_KB_1024

# The PSP decompresses the BIOS image to this address; it must end on a 64KB
# boundary, since the reset vector is the last 16 bytes of that segment. The
# PSP will not start it larger than 1MB or anywhere else. Without SPL this
# image is U-Boot; with SPL it is SPL (CONFIG_SPL_TEXT_BASE) and U-Boot proper
# stays in the flash for SPL to copy
config PPL_TEXT_BASE
	default 0x07150000

# Cache the whole of the flash window, so that SPL copies U-Boot proper
# quickly
config XIP_ROM_SIZE
	default 0x1000000 if SPL

# With SPL, the flash image, whose first 16MB is mapped below 4GB
config TURIN_IMAGE_ADDR
	default 0xff000000 if SPL
	default PPL_TEXT_BASE

config RESET_SEG_START
	default 0x07240000

config SYS_X86_START16
	default 0x0724f800

config RESET_VEC_LOC
	default 0x0724fff0

endif
