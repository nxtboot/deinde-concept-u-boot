[ -n "${do_configure}" ] && config_arg=",config_file"

# labgrid-client writes spurious output to stderr with Python 3.12 on Ubuntu
# 24.04, which would corrupt the parsed stdout, so keep it off stdout. Send it
# to the file named by U_BOOT_GETROLE_STDERR (conftest sets this so it can
# report the error if the query fails), or drop it when run standalone.

# Example spurious output:
# Error in sys.excepthook:
#
# Original exception was:
#

exec labgrid-client -r "${target}" ${vars} -a query -n \
	UBootProviderDriver:board,board_extra,source_dir,build_dir,build_dir_extra,prepare_timeout${config_arg} \
	2>"${U_BOOT_GETROLE_STDERR:-/dev/null}"
